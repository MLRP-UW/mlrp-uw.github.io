---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";
---

<Layout>
    <section class="mx-auto max-w-3xl px-6 pt-14 pb-10">
        <h1
            class="mb-4 text-4xl font-bold tracking-tight leading-none md:text-6xl"
        >
            Join MLRP
        </h1>
        <p class="text-text-muted">
            Application deadline: <strong>Friday, April 3rd at 11:59 PM</strong
            >.
        </p>
    </section>

    <div class="mx-auto max-w-3xl px-6">
        <div class="border-t border-divider"></div>
    </div>

    <!-- Mentee Application -->
    <section class="mx-auto max-w-3xl px-6 py-10">
        <h2 class="mb-2 text-2xl font-semibold">{site.forms.mentee.title}</h2>
        <p class="mb-4 text-text-muted">{site.forms.mentee.description}</p>
        <div class="mb-4 overflow-hidden rounded-lg border border-divider pt-3">
            <!-- Original height when form is open: height="800", also remove pt-3 from div above this comment-->
            <iframe
                src={site.forms.mentee.embedUrl}
                width="100%"
                height="300"
                frameborder="0"
                marginheight="0"
                marginwidth="0"
                title="Mentee Application Form"
                class="bg-cream"
            >
                Loading form...
            </iframe>
        </div>
        <p class="text-sm text-text-muted">
            Having trouble? <a
                href={site.forms.mentee.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent underline hover:text-accent-hover"
                >Open the form directly</a
            >.
        </p>
    </section>

    <div class="mx-auto max-w-3xl px-6">
        <div class="border-t border-divider"></div>
    </div>

    <!-- Mentor Application -->
    <section class="mx-auto max-w-3xl px-6 py-10">
        <h2 class="mb-2 text-2xl font-semibold">{site.forms.mentor.title}</h2>
        <p class="mb-4 text-text-muted">{site.forms.mentor.description}</p>
        <div class="mb-4 overflow-hidden rounded-lg border border-divider">
            <iframe
                src={site.forms.mentor.embedUrl}
                width="100%"
                height="800"
                frameborder="0"
                marginheight="0"
                marginwidth="0"
                title="Mentor Application Form"
                class="bg-cream"
            >
                Loading form...
            </iframe>
        </div>
        <p class="text-sm text-text-muted">
            Having trouble? <a
                href={site.forms.mentor.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent underline hover:text-accent-hover"
                >Open the form directly</a
            >.
        </p>
    </section>
</Layout>
